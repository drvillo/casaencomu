# First-account setup requires an operator-held random key (at least 32 characters).
# Generate locally: openssl rand -hex 32. Enter it at /entrar, then remove it after setup.
# An empty value disables first-account registration. Existing accounts can still sign in.
CASA_SETUP_TOKEN=
# The app has its own accounts and its own login, so none of the doors below is needed to run it:
# with the outer gates empty, a person signs in at /entrar. Initial setup still needs CASA_SETUP_TOKEN.
# Everything here is an OUTER gate, in front of that login, and Cloudflare wins where it is set.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
# The exact origin a browser sees — scheme, host AND port. `/api/import` compares it against the
# request's `Origin` header, so `https://host` against a site actually served at `http://host:8080`
# refuses every import with 403 "Petición no permitida" and nothing else looks wrong.
PUBLIC_URL=https://casa.example.com
# The data root. Inside it: control.db, and p/<project-id>/{casa.db,photos} — one database per
# project, so a query cannot read another project's rows. docs/SCALE.md § 4.
DATA_DIR=/data
# Scripts and one-off commands only: which project they act on when there is no request to ask.
# Never set this on the server — inside a request the membership check is the only answer.
CASA_PROJECT=
# dev only: skips every door, including our own login, when NODE_ENV=development
AUTH_DEV_EMAIL=
# preview only: shared-password Basic auth, used when the CF_ACCESS_* pair is absent
PREVIEW_PASSWORD=
# preview only: no prompt at all, every visitor is this identity. Tailnet-only hosts, never the internet.
PREVIEW_OPEN_AS=
# The fill layers (issue #111). With neither of the two lines below, layers 2 and 3 are skipped:
# the record still says what is missing, and no source is marked as done, so setting them later
# fills the whole backlog.
#
# Two ways to reach the model. Either an API key on its own:
#   ANTHROPIC_API_KEY=sk-ant-…
# or the local Claude Code CLI through the bridge, which needs no key (issue #113). Then the two
# lines are one pair: any long random string, the same one the bridge gets as CASA_AI_TOKEN.
#   ANTHROPIC_API_KEY=$(openssl rand -hex 24)
#   AI_BASE_URL=http://host.docker.internal:8788
ANTHROPIC_API_KEY=
AI_BASE_URL=
# Only read when AI_BASE_URL is empty; the bridge picks its own model with CASA_AI_MODEL.
AI_MODEL=

# Set by deploy.sh to a unique release image. Leave empty for local development.
CASA_IMAGE=

# Visit mail. docs/VISITAS.md. Empty MAIL_TRANSPORT means log: the letter is written to stdout
# and no socket is opened. Do not put a secret value in this file.
MAIL_TRANSPORT=
# Domain of visitas+<projectId>.<token>@<this>. Required before a letter can be addressed.
MAIL_REPLY_DOMAIN=
# Bearer secret for POST /api/visitas/entrada. Generate locally: openssl rand -hex 32.
# A missing value closes the webhook.
MAIL_INBOUND_SECRET=
# Optional. When set, this string is the From header. Reply-To stays the visitas address.
MAIL_ENVELOPE=
# Only read when MAIL_TRANSPORT=resend.
RESEND_API_KEY=
# Only read when MAIL_TRANSPORT=smtp. SMTP sends a letter. It does not open a mailbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
